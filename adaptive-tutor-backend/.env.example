# Adaptive Tutoring Backend — Environment Variables Example
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+psycopg2://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

SENTRY_DSN_BACKEND=
APP_ENV=production
ENABLE_SIMULATE_ENDPOINT=true
CORS_ORIGINS=https://neurodivergent.vercel.app,http://localhost:5173

TEST_DATABASE_URL=postgresql+psycopg2://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
